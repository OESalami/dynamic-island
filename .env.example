# JARVIS Dynamic Island — LiveKit client configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the template.
#
# Everything here is prefixed VITE_, which means Vite inlines it into the renderer
# bundle. That is correct for these four values and wrong for everything else:
#
#   NEVER put LIVEKIT_API_KEY or LIVEKIT_API_SECRET in a VITE_ variable.
#   Not during development either. The development token server is a hosted
#   LiveKit service that signs tokens for you, so no key or secret is needed in
#   this app at all. The build refuses to run if a VITE_ variable whose name
#   looks like a credential is present.
#
# Tokens are obtained from LiveKit's own development token server through the
# SDK's TokenSource API. There is no JARVIS backend to run.

# LiveKit signal (WebSocket) URL for your project, e.g. wss://your-project-abc123.livekit.cloud
VITE_LIVEKIT_URL=

# The deployed agent this app dispatches. Must match the agent name of the agent
# deployed on LiveKit Cloud. It is encoded into each session token's
# room_config, which is what makes the server dispatch it.
VITE_LIVEKIT_AGENT_NAME=my-agent

# Development Token Server ID, from your project's Settings page in LiveKit Cloud
# (the "Development token server" toggle must be on). The SDK sends this in the
# X-Sandbox-ID header. It is a routing label, not a credential.
VITE_LIVEKIT_TOKEN_SERVER_ID=


